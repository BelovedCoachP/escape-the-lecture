{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnaiid.com/schemas/escape-room/template-v1.json",
  "title": "Escape the Lecture: Faculty Template Content Schema v1",
  "description": "The faculty Template's contract: a strict subset of the repo's vault-schema v1.1. One level, exactly three challenges, three challenge types, text plus at most one image. Anything valid here (with the builder's injected defaults) also validates against the full schema, so a faculty room and the Exemplar are the same data structure with different production budgets. Accessibility fields are structurally required: a room that omits them will not validate, and therefore will not publish.",
  "type": "object",
  "required": ["schemaVersion", "meta", "narrative", "levels", "finale", "a11y"],
  "additionalProperties": false,

  "properties": {
    "schemaVersion": { "enum": ["1.0", "1.1"] },

    "meta": {
      "type": "object",
      "required": ["id", "title", "author", "renderer", "objective"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{3,60}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 90 },
        "subtitle": { "type": "string", "maxLength": 140 },
        "author": { "type": "string", "minLength": 1 },
        "course": { "type": "string" },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "The single learning objective this room is aligned to. Required: this is the field that keeps the build honest."
        },
        "renderer": { "const": "template" },
        "brandFooter": { "type": "string" }
      }
    },

    "narrative": {
      "type": "object",
      "required": ["premise", "roleTitle", "successCondition"],
      "additionalProperties": false,
      "properties": {
        "premise": { "type": "string", "minLength": 1 },
        "roleTitle": { "type": "string", "minLength": 1 },
        "successCondition": {
          "type": "string",
          "minLength": 1,
          "description": "Never a clock. The room opens when the work is done."
        },
        "companion": {
          "type": "object",
          "required": ["name", "textAlwaysVisible"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "textAlwaysVisible": { "const": true }
          }
        }
      }
    },

    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/level" }
    },

    "finale": {
      "type": "object",
      "required": ["title", "prompt", "rubric", "closingText"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "setup": { "type": "string" },
        "prompt": { "type": "string", "minLength": 1 },
        "replayEvidence": { "type": "boolean", "default": true },
        "companionAssessment": { "$ref": "#/$defs/companionLine" },
        "rubric": { "$ref": "#/$defs/rubric" },
        "acceptedPositions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "summary"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "summary": { "type": "string" }
            }
          }
        },
        "closingText": { "type": "string", "minLength": 1 }
      }
    },

    "a11y": {
      "type": "object",
      "description": "Compliance assertions, const not boolean: a non-compliant configuration cannot be expressed in valid content. The builder injects this block; it is not editable.",
      "required": ["audioAutoplay", "colorOnlySignals", "keyboardAlternatives", "reducedMotion", "timeLimit"],
      "additionalProperties": false,
      "properties": {
        "audioAutoplay": { "const": false },
        "colorOnlySignals": { "const": false },
        "keyboardAlternatives": { "const": true },
        "reducedMotion": { "const": "respected" },
        "timeLimit": { "const": "none" },
        "targetLevel": { "const": "WCAG 2.1 AA" }
      }
    }
  },

  "$defs": {
    "level": {
      "type": "object",
      "required": ["id", "order", "title", "brief", "challenges", "evidenceFragment", "unlockText"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{2,40}$" },
        "order": { "const": 1 },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "brief": { "type": "string", "minLength": 1 },
        "skillTaught": { "type": "array", "items": { "type": "string" } },
        "media": {
          "type": "array",
          "maxItems": 1,
          "items": { "$ref": "#/$defs/image" }
        },
        "companionLines": {
          "type": "array",
          "items": { "$ref": "#/$defs/companionLine" }
        },
        "challenges": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/challenge" }
        },
        "evidenceFragment": { "type": "string", "minLength": 1 },
        "unlockText": { "type": "string", "minLength": 1 },
        "rewardLabel": { "type": "string" }
      }
    },

    "challenge": {
      "oneOf": [
        { "$ref": "#/$defs/choiceChallenge" },
        { "$ref": "#/$defs/sequenceChallenge" },
        { "$ref": "#/$defs/responseChallenge" }
      ]
    },

    "hints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1 },
      "description": "Escalating tiers, always available, never penalized. A hint narrows the search space; it never contains the answer."
    },

    "choiceChallenge": {
      "type": "object",
      "required": ["type", "id", "prompt", "options", "hints"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "choice" },
        "id": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "selectMultiple": { "type": "boolean", "default": false },
        "hints": { "$ref": "#/$defs/hints" },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["id", "text", "correct", "feedback"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "correct": { "type": "boolean" },
              "feedback": {
                "type": "string",
                "minLength": 1,
                "description": "Required on every option, including correct ones. A wrong answer with no explanation is a dead end, not a puzzle."
              }
            }
          }
        }
      }
    },

    "sequenceChallenge": {
      "type": "object",
      "required": ["type", "id", "prompt", "items", "correctOrder", "hints", "keyboardInstructions"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "sequence" },
        "id": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "hints": { "$ref": "#/$defs/hints" },
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "correctOrder": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string" }
        },
        "keyboardInstructions": {
          "type": "string",
          "minLength": 1,
          "description": "Required. Drag is never the only path. The builder prefills a working default."
        },
        "explanation": { "type": "string" }
      }
    },

    "responseChallenge": {
      "type": "object",
      "required": ["type", "id", "prompt", "rubric", "exemplarAnswer", "hints"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "response" },
        "id": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "placeholder": { "type": "string" },
        "maxLength": { "type": "integer", "default": 600 },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["label"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "placeholder": { "type": "string" },
              "maxLength": { "type": "integer" }
            }
          }
        },
        "hints": { "$ref": "#/$defs/hints" },
        "companionAssessment": { "$ref": "#/$defs/companionLine" },
        "rubric": { "$ref": "#/$defs/rubric" },
        "exemplarAnswer": { "type": "string", "minLength": 1 }
      }
    },

    "companionLine": {
      "type": "object",
      "description": "Text-only in the Template. If the companion is wrong, the tell is required: the content must say how the player could have caught it.",
      "required": ["id", "text", "accurate"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
        "accurate": { "type": "boolean" },
        "tell": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "accurate": { "const": false } }, "required": ["accurate"] },
          "then": { "required": ["tell"] }
        }
      ]
    },

    "rubric": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["criterion", "lookFor"],
        "additionalProperties": false,
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "lookFor": { "type": "string", "minLength": 1 },
          "commonMiss": { "type": "string" }
        }
      }
    },

    "image": {
      "type": "object",
      "required": ["kind", "src", "decorative"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "image" },
        "id": { "type": "string" },
        "src": { "type": "string", "minLength": 1 },
        "decorative": { "type": "boolean" },
        "alt": { "type": "string" },
        "longDescription": { "type": "string" },
        "credit": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "decorative": { "const": false } }, "required": ["decorative"] },
          "then": { "required": ["alt"], "properties": { "alt": { "minLength": 1 } } }
        },
        {
          "if": { "properties": { "decorative": { "const": true } }, "required": ["decorative"] },
          "then": { "properties": { "alt": { "const": "" } } }
        }
      ]
    }
  }
}
